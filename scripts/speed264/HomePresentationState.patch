 import Foundation
 
+enum SpeedPauseReason: String, Equatable {
+    case pictureInPictureConflict
+    case unexpectedPiPStop
+
+    var title: String {
+        switch self {
+        case .pictureInPictureConflict:
+            return L10n.text("120Hz 已暂停", "120Hz paused")
+        case .unexpectedPiPStop:
+            return L10n.text("Speed 已暂停", "Speed paused")
+        }
+    }
+
+    var detail: String {
+        switch self {
+        case .pictureInPictureConflict:
+            return L10n.text(
+                "Speed 悬浮窗被其他画中画占用或顶替，当前高刷新保持已暂停。关闭其他画中画后，重新启动 Speed 即可恢复。",
+                "Another Picture in Picture session replaced or occupied Speed's PiP. High-refresh keep-alive is paused. Close the other PiP and restart Speed to resume."
+            )
+        case .unexpectedPiPStop:
+            return L10n.text(
+                "Speed 悬浮窗被系统意外停止，当前高刷新保持已暂停。重新启动悬浮窗即可恢复。",
+                "The system unexpectedly stopped Speed's PiP. High-refresh keep-alive is paused. Restart the floating window to resume."
+            )
+        }
+    }
+}
