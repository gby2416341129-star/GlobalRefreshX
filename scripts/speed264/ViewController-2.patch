+    private func currentSystemPiPPlacementSample() -> (view: UIView, frame: CGRect, screen: CGRect)? {
+        let screen = view.window?.windowScene?.screen.bounds ?? AppDisplayContext.bounds
+        var candidates: [UIView] = []
+        if let customView, customView.window != nil, customView.window !== view.window {
+            var current: UIView? = customView
+            while let candidate = current {
+                let frame = candidate.convert(candidate.bounds, to: nil)
+                if frame.width >= 20,
+                   frame.height >= 12,
+                   frame.width < screen.width * 0.96,
+                   frame.height < screen.height * 0.96 {
+                    candidates.append(candidate)
+                }
+                current = candidate.superview
+            }
+        }
+        if let host = candidatePiPGestureHostView(), host.window !== view.window {
+            let frame = host.convert(host.bounds, to: nil)
+            if frame.width >= 20,
+               frame.height >= 12,
+               frame.width < screen.width * 0.96,
+               frame.height < screen.height * 0.96 {
+                candidates.append(host)
+            }
+        }
+        guard let best = candidates.last else { return nil }
+        let frame = best.convert(best.bounds, to: nil)
+        guard frame.width > 8, frame.height > 8 else { return nil }
+        return (best, frame, screen)
+    }
