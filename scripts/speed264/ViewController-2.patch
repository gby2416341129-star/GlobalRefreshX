+    private func normalizedPiPCenterY(_ frame: CGRect, screen: CGRect) -> CGFloat {
+        guard screen.height > 1 else { return 0.5 }
+        return (frame.midY - screen.minY) / screen.height
+    }
+
+    private func detectedSideStash(frame: CGRect, screen: CGRect) -> (edge: PiPSideStashEdge, hiddenFraction: CGFloat)? {
+        guard frame.width > 8, frame.height > 8 else { return nil }
+        let leftHidden = max(0, screen.minX - frame.minX) / frame.width
+        let rightHidden = max(0, frame.maxX - screen.maxX) / frame.width
+        let visibleWidth = frame.intersection(screen).width
+        let visibleFraction = max(0, min(1, visibleWidth / frame.width))
+        let inferredHidden = 1 - visibleFraction
+        let leftScore = max(leftHidden, frame.midX < screen.minX ? inferredHidden : 0)
+        let rightScore = max(rightHidden, frame.midX > screen.maxX ? inferredHidden : 0)
+        let hiddenFraction = max(leftScore, rightScore)
+        guard hiddenFraction >= 0.42 else { return nil }
+        return leftScore >= rightScore ? (.left, hiddenFraction) : (.right, hiddenFraction)
+    }
