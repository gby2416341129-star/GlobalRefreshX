diff --git a/.github/workflows/build-ipa.yml b/.github/workflows/build-ipa.yml
index 628875dec371f80ea96dacad049c618997db0180..59081d2a35b3a261d16bf09ddc4035ac0ea8b1fa 100644
--- a/.github/workflows/build-ipa.yml
+++ b/.github/workflows/build-ipa.yml
@@ -1,4 +1,4 @@
-name: Build Speed 2.2.0 Final Candidate 1 IPA
+name: Build Speed 2.3.0 Laboratory 1 IPA
 
 on:
   workflow_dispatch:
@@ -17,7 +17,7 @@ jobs:
       - name: Check out repository
         uses: actions/checkout@v4
 
-      - name: Locate or unpack Speed 2.2.0 Final Candidate 1 source
+      - name: Locate or unpack Speed 2.3.0 Laboratory 1 source
         shell: bash
         run: |
           set -euo pipefail
@@ -31,9 +31,9 @@ jobs:
           rm -rf "$GITHUB_WORKSPACE/source"
 
           archive="$(find "$GITHUB_WORKSPACE" -maxdepth 4 -type f \
-            \( -name 'Speed-2.2.0-Final-Candidate-1-Source.tar.gz' \
-               -o -name 'Speed-2.2.0-Final-Candidate-1-Source.tar.gz*' \
-               -o -iname '*Speed*2.2.0*Final*Candidate*1*Source*.tar.gz*' \) \
+            \( -name 'Speed-2.3.0-Laboratory-1-Source.tar.gz' \
+               -o -name 'Speed-2.3.0-Laboratory-1-Source.tar.gz*' \
+               -o -iname '*Speed*2.3.0*Laboratory*1*Source*.tar.gz*' \) \
             -print -quit)"
 
           if [[ -n "$archive" ]]; then
@@ -51,7 +51,7 @@ jobs:
             -print -quit)"
 
           if [[ -z "$workspace_data" ]]; then
-            echo 'ERROR: Speed 2.2.0 Final Candidate 1 source was not found.' >&2
+            echo 'ERROR: Speed 2.3.0 Laboratory 1 source was not found.' >&2
             exit 2
           fi
 
@@ -69,8 +69,8 @@ jobs:
           test -f "$ios_dir/Podfile.lock"
           test -f "$ios_dir/Pods/Manifest.lock"
           cmp -s "$ios_dir/Podfile.lock" "$ios_dir/Pods/Manifest.lock"
-          grep -q 'MARKETING_VERSION = 2.2.0' "$ios_dir/pip_swift.xcodeproj/project.pbxproj"
-          grep -q 'CURRENT_PROJECT_VERSION = 2026090904' "$ios_dir/pip_swift.xcodeproj/project.pbxproj"
+          grep -q 'MARKETING_VERSION = 2.3.0' "$ios_dir/pip_swift.xcodeproj/project.pbxproj"
+          grep -q 'CURRENT_PROJECT_VERSION = 2026090905' "$ios_dir/pip_swift.xcodeproj/project.pbxproj"
           grep -q 'PRODUCT_NAME = Speed' "$ios_dir/pip_swift.xcodeproj/project.pbxproj"
 
           echo "PROJECT_ROOT=$project_root" >> "$GITHUB_ENV"
@@ -81,7 +81,7 @@ jobs:
         shell: bash
         run: "$PROJECT_ROOT/scripts/select_xcode_26.sh"
 
-      - name: Verify final candidate source
+      - name: Verify Laboratory source
         shell: bash
         run: "$PROJECT_ROOT/scripts/verify_project.sh"
 
@@ -95,17 +95,17 @@ jobs:
           set -euo pipefail
           mkdir -p "$GITHUB_WORKSPACE/out"
           cp "$PROJECT_ROOT/dist/Speed-unsigned.ipa" \
-             "$GITHUB_WORKSPACE/out/Speed-2.2.0-Final-Candidate-1-unsigned.ipa"
-          unzip -t "$GITHUB_WORKSPACE/out/Speed-2.2.0-Final-Candidate-1-unsigned.ipa"
+             "$GITHUB_WORKSPACE/out/Speed-2.3.0-Laboratory-1-unsigned.ipa"
+          unzip -t "$GITHUB_WORKSPACE/out/Speed-2.3.0-Laboratory-1-unsigned.ipa"
           shasum -a 256 \
-            "$GITHUB_WORKSPACE/out/Speed-2.2.0-Final-Candidate-1-unsigned.ipa" \
-            > "$GITHUB_WORKSPACE/out/Speed-2.2.0-Final-Candidate-1-unsigned.ipa.sha256"
+            "$GITHUB_WORKSPACE/out/Speed-2.3.0-Laboratory-1-unsigned.ipa" \
+            > "$GITHUB_WORKSPACE/out/Speed-2.3.0-Laboratory-1-unsigned.ipa.sha256"
 
       - name: Upload Xcode diagnostics
         if: always()
         uses: actions/upload-artifact@v4
         with:
-          name: Speed-2.2.0-Final-Candidate-1-Xcode-Diagnostics
+          name: Speed-2.3.0-Laboratory-1-Xcode-Diagnostics
           path: |
             ${{ env.PROJECT_ROOT }}/build/diagnostics/xcodebuild.log
             ${{ env.PROJECT_ROOT }}/build/diagnostics/Speed.xcresult
@@ -115,10 +115,10 @@ jobs:
       - name: Upload unsigned IPA
         uses: actions/upload-artifact@v4
         with:
-          name: Speed-2.2.0-Final-Candidate-1-IPA
+          name: Speed-2.3.0-Laboratory-1-IPA
           path: |
-            out/Speed-2.2.0-Final-Candidate-1-unsigned.ipa
-            out/Speed-2.2.0-Final-Candidate-1-unsigned.ipa.sha256
+            out/Speed-2.3.0-Laboratory-1-unsigned.ipa
+            out/Speed-2.3.0-Laboratory-1-unsigned.ipa.sha256
           if-no-files-found: error
 
       - name: Publish rolling prerelease
@@ -127,19 +127,19 @@ jobs:
         shell: bash
         run: |
           set -euo pipefail
-          ipa="$GITHUB_WORKSPACE/out/Speed-2.2.0-Final-Candidate-1-unsigned.ipa"
+          ipa="$GITHUB_WORKSPACE/out/Speed-2.3.0-Laboratory-1-unsigned.ipa"
 
           if gh release view dev-latest >/dev/null 2>&1; then
             gh release upload dev-latest "$ipa" --clobber
             gh release edit dev-latest \
               --target "$GITHUB_SHA" \
-              --title "Speed Final Candidate" \
-              --notes "Speed 2.2.0 Final Candidate 1 unsigned IPA. Sign before installation." \
+              --title "Speed Laboratory Build" \
+              --notes "Speed 2.3.0 Laboratory 1 unsigned IPA. Existing Speed UI/core retained; Laboratory latency experiments are opt-in. Sign before installation." \
               --prerelease
           else
             gh release create dev-latest "$ipa" \
               --target "$GITHUB_SHA" \
-              --title "Speed Final Candidate" \
-              --notes "Speed 2.2.0 Final Candidate 1 unsigned IPA. Sign before installation." \
+              --title "Speed Laboratory Build" \
+              --notes "Speed 2.3.0 Laboratory 1 unsigned IPA. Existing Speed UI/core retained; Laboratory latency experiments are opt-in. Sign before installation." \
               --prerelease
           fi
