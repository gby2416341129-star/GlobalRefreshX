+        state.continuousUpdatesEnabled = enabled
+        rebuildUpdateLink()
+    }
+
+    func setAllEnabled(_ enabled: Bool) {
+        state.lowLatencyEventDispatchEnabled = enabled
+        state.immediatePresentationEnabled = enabled
+        state.continuousUpdatesEnabled = enabled
+        rebuildUpdateLink()
+    }
+
+    /// Re-evaluate after foreground transitions. UIUpdateLink is attached to
+    /// a view and therefore follows that view's display automatically.
+    func reconcile() {
+        guard state.anyPreferenceEnabled else {
+            stopUpdateLink()
+            return
+        }
+        if updateLink == nil || updateLink?.isEnabled == false {
+            rebuildUpdateLink()
+        }
+    }
+
+    func stopForTeardown() {
+        stopUpdateLink()
+        anchorView = nil
+        state = LatencyExperimentState()
+    }
+
+    private func rebuildUpdateLink() {
+        stopUpdateLink(resetPreferences: false)
+
+        guard state.anyPreferenceEnabled,
+              let anchorView,
+              anchorView.window != nil
+        else {
+            state.updateLinkActive = false
+            return
+        }
+
+        let link = UIUpdateLink(view: anchorView)
+        link.wantsLowLatencyEventDispatch = state.lowLatencyEventDispatchEnabled
+        link.wantsImmediatePresentation = state.immediatePresentationEnabled
+        link.requiresContinuousUpdates = state.continuousUpdatesEnabled
+
+        // Keep the experimental update path aligned with Speed's production
+        // 120 Hz request. This remains a preference; iOS is the final arbiter.
+        let requested = Float(min(FrameRatePreference.targetFrameRate, AppDisplayContext.maximumFramesPerSecond))
+        link.preferredFrameRateRange = CAFrameRateRange(
+            minimum: requested,
+            maximum: requested,
+            preferred: requested
+        )
+        link.isEnabled = true
+        updateLink = link
+        state.updateLinkActive = true
+        AppDebugLogger.log(
+            "Laboratory UIUpdateLink active: lowLatency=\(state.lowLatencyEventDispatchEnabled), "
+            + "immediate=\(state.immediatePresentationEnabled), continuous=\(state.continuousUpdatesEnabled), "
+            + "fps=\(Int(requested))"
+        )
+    }
+
+    private func stopUpdateLink(resetPreferences: Bool = false) {
+        updateLink?.isEnabled = false
+        updateLink = nil
+        state.updateLinkActive = false
+        if resetPreferences {
+            state = LatencyExperimentState()
+        }
+    }
+}
