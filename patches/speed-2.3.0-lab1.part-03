diff --git a/scripts/verify_project.sh b/scripts/verify_project.sh
index c02e3d36ee549bd89cfeca1a5d588acbc5254f7a..2271cec56b39e98297c849ac75ce50c4075e0a21 100755
--- a/scripts/verify_project.sh
+++ b/scripts/verify_project.sh
@@ -11,8 +11,8 @@ APP="pip_swift/pip_swift"
 VC="$APP/ViewController.swift"
 REFRESH="$APP/RefreshRateController.swift"
 
-check 'Speed version 2.2.0' "grep -q 'MARKETING_VERSION = 2.2.0' '$PROJECT'"
-check 'Speed Final Candidate build number' "grep -q 'CURRENT_PROJECT_VERSION = 2026090904' '$PROJECT'"
+check 'Speed version 2.3.0' "grep -q 'MARKETING_VERSION = 2.3.0' '$PROJECT'"
+check 'Speed Laboratory build number' "grep -q 'CURRENT_PROJECT_VERSION = 2026090905' '$PROJECT'"
 check 'Speed bundle identifier' "grep -q 'PRODUCT_BUNDLE_IDENTIFIER = com.isil.speed' '$PROJECT'"
 check 'Speed product name' "grep -q 'PRODUCT_NAME = Speed' '$PROJECT'"
 check 'Automatic signing ready' "grep -q 'CODE_SIGN_STYLE = Automatic' '$PROJECT'"
@@ -26,7 +26,7 @@ check 'Only production PiP routes remain' "test \"\$(grep -c '^    case ' '$VC'
 check 'Legacy transition coordinator physically removed' "! test -f '$APP/PiPTransitionCoordinator.swift' && ! grep -R -q 'PiPTransitionCoordinator' '$APP' --include='*.swift'"
 check 'Single lifecycle truth owns intent and AVKit confirmation' "grep -q 'private(set) var wantsActive' '$APP/PiPLifecycleController.swift' && grep -q 'private(set) var confirmedActive' '$APP/PiPLifecycleController.swift' && grep -q 'private(set) var suspendedAtSide' '$APP/PiPLifecycleController.swift'"
 check 'Live refresh mode does not read UserDefaults' "grep -q 'enum RefreshRuntimeMode' '$REFRESH' && ! grep -q 'UserDefaults.standard' '$REFRESH'"
-check 'Standard route avoids fragile UIUpdateLink startup hook' "! grep -q 'UIUpdateLink(windowScene:' '$REFRESH' && ! grep -q 'private var updateLink' '$REFRESH' && grep -q 'CADisplayLink(target:' '$REFRESH'"
+check 'Stable Standard route remains CADisplayLink-only before Laboratory section' "! awk '/MARK: - Laboratory/{exit} {print}' '$REFRESH' | grep -q 'UIUpdateLink(' && awk '/MARK: - Laboratory/{exit} {print}' '$REFRESH' | grep -q 'CADisplayLink(target:'"
 check 'Compatibility route reverted to stable AVPlayer playback' "! grep -q 'playImmediately(atRate: 1.0)' '$VC' && ! grep -q 'automaticallyWaitsToMinimizeStalling = false' '$VC'"
 check 'Alpha49-style hard-max display link retained' "test \"\$(grep -c 'CADisplayLink(target:' '$REFRESH')\" -eq 1 && grep -q 'forMode: .common' '$REFRESH' && grep -q 'Intentionally empty' '$REFRESH'"
 check '120Hz minimum pin retained' "grep -q 'minimum: requested' '$REFRESH'"
@@ -55,6 +55,9 @@ check 'Standard route does not register lock-screen audio observers' "! grep -q
 check 'Standard PiP keepalive performs no media/audio work' "grep -q 'PiP-only keepAlive without media/audio work' '$VC'"
 check 'Home SwiftUI root is created once' "grep -q 'SpeedHomeViewModel' '$APP/PiPViews.swift' && grep -q 'UIHostingController(rootView: PiPHomeView(model: model))' '$VC' && ! grep -q 'hostingController.rootView =' '$VC'"
 check 'Home model coalesces state updates' "grep -q 'objectWillChange.send()' '$APP/PiPViews.swift'"
+check 'Laboratory UIUpdateLink is explicit opt-in only' "grep -q 'final class LatencyExperimentController' '$REFRESH' && grep -q 'UIUpdateLink(view: anchorView)' '$REFRESH' && grep -q 'guard state.anyPreferenceEnabled' '$REFRESH'"
